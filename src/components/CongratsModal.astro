---
// CongratsModal.astro: Modal chúc mừng kèm kết quả số ghế
---

<div id="modalCongrats" class="modal-overlay" style="display: none;">
  <div class="modal-box">
    <div class="modal-icon">
      <svg class="modal-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h2" />
        <path d="M18 9h2a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-2" />
        <path d="M4 3h16v6a8 8 0 0 1-16 0V3z" />
        <path d="M12 17v4" />
        <path d="M8 21h8" />
      </svg>
    </div>
    <div class="congrats-label">CHÚC MỪNG</div>
    <h2 id="congratsPlayerName" class="modal-title congrats-name">NGƯỜI CHƠI</h2>
    
    <div class="seat-result-box">
      <div id="congratsFormula" class="seat-formula">
        5 + 7 + 8 = 20
      </div>
      <div class="seat-label">
        SỐ GHẾ CỦA BẠN LÀ:
      </div>
      <div id="congratsSeatNum" class="seat-result-num">
        GHẾ #20
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 999;
  }

  .modal-box {
    background: rgba(18, 18, 24, 0.96);
    border: 5px solid var(--gold-primary);
    border-radius: 24px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9),
      inset 0 0 35px rgba(245, 158, 11, 0.25);
    padding: 48px 40px;
    max-width: 620px;
    width: 90%;
    text-align: center;
    animation: modalPopAnim 0.35s ease;
  }

  @keyframes modalPopAnim {
    0% { transform: scale(0.2) rotate(25deg); opacity: 0; }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .modal-svg-icon {
    width: 72px;
    height: 72px;
    color: var(--gold-light);
    margin-bottom: 16px;
    display: inline-block;
    filter: drop-shadow(0 6px 14px rgba(245, 158, 11, 0.5));
    animation: bounceAnim 1.8s infinite;
  }

  @keyframes bounceAnim {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .congrats-label {
    font-family: var(--font-arcade);
    font-size: 16px;
    color: #a7f3d0;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .modal-title {
    font-family: var(--font-arcade);
    font-weight: 700;
    font-size: clamp(22px, 4.5vw, 32px);
    color: var(--gold-light);
    letter-spacing: 1px;
    margin-bottom: 12px;
    word-break: break-word;
    overflow-wrap: anywhere;
    line-height: 1.25;
    max-width: 100%;
  }

  .seat-result-box {
    background: rgba(0, 0, 0, 0.75);
    border: 3px solid rgba(245, 158, 11, 0.8);
    border-radius: 20px;
    padding: 24px;
    margin: 24px 0;
  }

  .seat-formula {
    font-size: 16px;
    color: var(--gold-light);
    font-weight: bold;
    margin-bottom: 8px;
  }

  .seat-label {
    font-size: 13px;
    color: #a7f3d0;
    font-weight: bold;
  }

  .seat-result-num {
    font-family: var(--font-arcade);
    font-weight: 800;
    font-size: 72px;
    color: var(--gold-light);
    text-shadow: 0 6px 24px rgba(245, 158, 11, 0.95);
    margin-top: 8px;
  }

  .btn-balatro {
    font-family: var(--font-arcade);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.5px;
    padding: 18px 36px;
    border-radius: 14px;
    border: 3px solid #ffffff;
    background: var(--balatro-orange);
    color: #ffffff;
    cursor: pointer;
    text-transform: uppercase;
    box-shadow: 0 6px 0 #8c4b00, 0 12px 18px rgba(0, 0, 0, 0.5);
    transition: all 0.1s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    outline: none;
  }

  .btn-blue {
    background: var(--balatro-blue);
    box-shadow: 0 5px 0 #0d4b85, 0 10px 15px rgba(0, 0, 0, 0.5);
  }

  .btn-blue:hover {
    box-shadow: 0 7px 0 #0d4b85, 0 12px 18px rgba(0, 0, 0, 0.5);
    filter: brightness(1.1);
  }

  .btn-blue:active {
    box-shadow: 0 1px 0 #0d4b85, 0 3px 6px rgba(0, 0, 0, 0.5);
    transform: translateY(4px);
  }

  .btn-icon {
    width: 20px;
    height: 20px;
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .modal-box {
      padding: 24px 18px;
      border-radius: 18px;
      border-width: 3px;
      max-width: 92%;
    }

    .modal-svg-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 8px;
    }

    .congrats-label {
      font-size: 13px;
      letter-spacing: 1.5px;
      margin-bottom: 4px;
    }

    .modal-title {
      font-size: 20px;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }

    .seat-result-box {
      padding: 16px 12px;
      margin: 16px 0;
      border-radius: 14px;
    }

    .seat-result-num {
      font-size: 46px;
    }

    .btn-balatro {
      font-size: 15px;
      padding: 13px 18px;
      border-radius: 10px;
      letter-spacing: 0.3px;
      gap: 8px;
    }
  }
</style>
