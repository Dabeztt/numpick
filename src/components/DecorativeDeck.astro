---
// DecorativeDeck.astro: Tụ bài bốc xếp tầng 3D trang trí ở giữa bàn
import { Image } from 'astro:assets';
import cardBack from '../assets/cards/card_back.png';
---

<div class="center-stage">
  <div id="deckShoe" class="deck-shoe-container" title="Bộ bài bốc (Trang trí)">
    <div class="deck-shoe-stack">
      <div class="deck-layer deck-layer-3"></div>
      <div class="deck-layer deck-layer-2"></div>
      <div class="deck-layer deck-layer-1"></div>
      <div class="deck-top-card">
        <Image src={cardBack} alt="Bộ bài bốc" class="pixelated" />
      </div>
    </div>
  </div>
</div>

<style>
  .center-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
  }

  .deck-shoe-container {
    width: var(--deck-w, var(--card-w));
    height: var(--deck-h, var(--card-h));
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
  }

  .deck-shoe-stack {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .deck-shoe-container:hover .deck-shoe-stack {
    transform: translateY(-4px) scale(1.03);
  }

  /* Stacked cards layers for physical deck thickness */
  .deck-layer {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  .deck-layer-3 {
    transform: translate(6px, 6px) rotate(2.5deg);
    background: #f1f5f9;
    border-color: #94a3b8;
    z-index: 1;
  }

  .deck-layer-2 {
    transform: translate(4px, 4px) rotate(-1.5deg);
    background: #f8fafc;
    border-color: #cbd5e1;
    z-index: 2;
  }

  .deck-layer-1 {
    transform: translate(2px, 2px) rotate(0.8deg);
    background: #ffffff;
    border-color: #e2e8f0;
    z-index: 3;
  }

  .deck-top-card {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    overflow: hidden;
    z-index: 4;
    box-shadow:
      -1px 1px 0 #ffffff,
      -2px 2px 0 #e2e8f0,
      -3px 3px 0 #cbd5e1,
      -4px 4px 0 #94a3b8,
      -5px 5px 0 #64748b,
      -6px 6px 0 #334155,
      -7px 7px 0 #1e293b,
      0 18px 36px rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .deck-top-card img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
  }
</style>
