---
// PokerTable.astro: Khung bàn Poker toàn màn hình với logo chìm và layout bàn chơi
---

<div class="fullscreen-poker-table">
  <!-- Table Watermark -->
  <div class="table-watermark">
    <svg class="watermark-svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C9.5 7 4 10.5 4 15c0 3 2.5 5 5 5 1.8 0 3-1 3-2 0 1 1.2 2 3 2 2.5 0 5-2 5-5 0-4.5-5.5-8-8-13z"/>
      <path d="M10 20h4v2h-4z"/>
    </svg>
  </div>

  <!-- Hands Arena (Full Edge-to-Edge Poker Table) -->
  <div class="poker-hands-circle">
    <slot />
  </div>

  <!-- Flight Arena for Cards Flying from Center Deck -->
  <div id="flightArena" class="flight-arena"></div>
</div>

<style>
  .fullscreen-poker-table {
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-casino);
    border: 8px solid var(--wood-border);
    outline: 3px solid var(--gold-dark);
    outline-offset: -8px;
    box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.6),
      inset 0 0 40px rgba(245, 158, 11, 0.15);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 14px 6px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .fullscreen-poker-table {
      border: 12px solid var(--wood-border);
      outline: 4px solid var(--gold-dark);
      outline-offset: -12px;
      box-shadow: inset 0 0 140px rgba(0, 0, 0, 0.6),
        inset 0 0 60px rgba(245, 158, 11, 0.2);
      padding: 12px 14px;
    }
  }

  .poker-hands-circle {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 20;
  }

  .table-watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0.05;
  }

  .watermark-svg {
    width: 170px;
    height: 170px;
    color: #ffffff;
  }

  @media (min-width: 768px) {
    .watermark-svg {
      width: 320px;
      height: 320px;
    }
  }

  :global(.table-middle-row) {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px;
    pointer-events: none;
    z-index: 20;
  }

  :global(.table-middle-row > *) {
    pointer-events: auto;
  }

  .flight-arena {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 100;
    overflow: hidden;
  }

  :global(.flying-card) {
    position: fixed;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.85), 0 0 16px rgba(245, 158, 11, 0.4);
    pointer-events: none;
    will-change: transform, left, top;
    z-index: 100;
  }
</style>
