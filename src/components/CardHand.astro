---
interface Props {
  tuId: string;
  direction: 'bottom' | 'top' | 'left' | 'right';
  isPlayer?: boolean;
}

const { tuId, direction, isPlayer = false } = Astro.props;
---

<div class={`tu-zone tu-dir-${direction} ${isPlayer ? 'tu-player' : ''}`} data-direction={direction}>
  <div class="tu-hand-rotator">
    <div id={tuId} class="tu-fanned-hand">
      <!-- 3 card slots generated dynamically -->
    </div>
  </div>
</div>

<style>
  .tu-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 20;
  }

  .tu-dir-top {
    margin-top: 10px;
  }

  .tu-dir-bottom {
    margin-bottom: 10px;
  }

  @media (min-width: 768px) {
    .tu-dir-top {
      margin-top: 14px;
    }

    .tu-dir-bottom {
      margin-bottom: 14px;
    }
  }

  .tu-dir-left {
    margin-left: calc(-1 * (var(--card-w) * 0.55));
  }

  .tu-dir-right {
    margin-right: calc(-1 * (var(--card-w) * 0.55));
  }

  /* Unified Fanned Hand Container */
  .tu-fanned-hand {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: calc(var(--card-h) + 14px);
    padding: 0 16px;
    position: relative;
  }

  @media (min-width: 768px) {
    .tu-fanned-hand {
      height: calc(var(--card-h) + 18px);
      padding: 0 40px;
    }
  }

  /* Directional Rotators */
  .tu-hand-rotator {
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    transition: transform 0.3s ease;
  }

  .tu-dir-bottom .tu-hand-rotator {
    transform: rotate(0deg);
  }

  .tu-dir-top .tu-hand-rotator {
    transform: rotate(180deg);
  }

  .tu-dir-left .tu-hand-rotator {
    transform: rotate(90deg);
  }

  .tu-dir-right .tu-hand-rotator {
    transform: rotate(-90deg);
  }

  /* Dynamic Card Slots & Fan Rotations */
  :global(.fan-slot-0) {
    transform: rotate(-11deg) translateY(6px);
    margin-right: var(--fan-overlap);
    z-index: 1;
  }

  :global(.fan-slot-1) {
    transform: rotate(0deg) translateY(-8px);
    z-index: 2;
  }

  :global(.fan-slot-2) {
    transform: rotate(11deg) translateY(6px);
    margin-left: var(--fan-overlap);
    z-index: 3;
  }

  :global(.card-placeholder) {
    width: var(--card-w);
    height: var(--card-h);
    opacity: 0;
    pointer-events: none;
  }

  :global(.card-slot) {
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1), z-index 0.1s ease;
  }

  :global(.card-clickable) {
    cursor: pointer;
  }

  :global(.card-clickable:hover) {
    transform: translateY(-24px) scale(1.12) rotate(0deg) !important;
    z-index: 50 !important;
  }

  @media (max-width: 640px) {
    :global(.card-clickable:hover) {
      transform: translateY(-16px) scale(1.08) rotate(0deg) !important;
    }
  }

  :global(.card-wrapper) {
    perspective: 1000px;
    width: var(--card-w);
    height: var(--card-h);
    position: relative;
  }

  :global(.card-inner) {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    border-radius: 8px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
  }

  :global(.card-wrapper.flipped .card-inner) {
    transform: rotateY(180deg);
  }

  :global(.card-face) {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 8px;
    overflow: hidden;
  }

  :global(.card-back) {
    transform: rotateY(0deg);
  }

  :global(.card-front) {
    transform: rotateY(180deg);
  }

  :global(.card-face img) {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
  }

  /* Deal Animation: Smooth, non-shifting entrance */
  @keyframes dealCardAnim {
    0% {
      transform: scale(0.3) translateY(-25px) rotate(15deg);
      opacity: 0;
    }
    100% {
      transform: scale(1) translateY(0) rotate(0deg);
      opacity: 1;
    }
  }

  :global(.animate-deal) {
    animation: dealCardAnim 0.35s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }
</style>
