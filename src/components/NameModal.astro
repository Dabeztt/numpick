---
// NameModal.astro: Modal nhập tên ban đầu
---

<div id="modalName" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-icon">
      <svg class="modal-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="13" height="17" rx="2" />
        <path d="M8 5V3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-2" />
        <path d="M9.5 13.5l-1-1 1-1 1 1-1 1z" fill="currentColor" />
      </svg>
    </div>
    <h2 class="modal-title">NHẬP TÊN NHÀ CÁI</h2>
    <p class="modal-desc">Nhập tên để bắt đầu ván bài</p>
    
    <form id="formName">
      <input
        type="text"
        id="inputName"
        placeholder="Nhập tên của bạn..."
        maxlength="20"
        required
        autocomplete="off"
        class="input-name"
      />
      <button type="submit" class="btn-balatro" style="width: 100%;">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C9.5 7 4 10.5 4 15c0 3 2.5 5 5 5 1.8 0 3-1 3-2 0 1 1.2 2 3 2 2.5 0 5-2 5-5 0-4.5-5.5-8-8-13z"/>
          <path d="M10 20h4v2h-4z"/>
        </svg>
        <span>BẮT ĐẦU CHIA BÀI</span>
      </button>
    </form>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 999;
  }

  .modal-box {
    background: rgba(18, 18, 24, 0.96);
    border: 5px solid var(--gold-primary);
    border-radius: 24px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9),
      inset 0 0 35px rgba(245, 158, 11, 0.25);
    padding: 48px 40px;
    max-width: 620px;
    width: 90%;
    text-align: center;
    animation: modalPopAnim 0.35s ease;
  }

  @keyframes modalPopAnim {
    0% { transform: scale(0.2) rotate(25deg); opacity: 0; }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .modal-svg-icon {
    width: 72px;
    height: 72px;
    color: var(--gold-light);
    margin-bottom: 16px;
    display: inline-block;
    filter: drop-shadow(0 6px 14px rgba(245, 158, 11, 0.5));
    animation: bounceAnim 1.8s infinite;
  }

  @keyframes bounceAnim {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .modal-title {
    font-family: var(--font-arcade);
    font-weight: 700;
    font-size: 34px;
    color: var(--gold-light);
    letter-spacing: 1.5px;
    margin-bottom: 12px;
  }

  .modal-desc {
    font-size: 18px;
    color: #a7f3d0;
    margin-bottom: 28px;
  }

  .input-name {
    width: 100%;
    background: rgba(0, 0, 0, 0.85);
    border: 3px solid var(--gold-primary);
    border-radius: 12px;
    padding: 18px 24px;
    color: var(--gold-light);
    font-family: var(--font-arcade);
    font-size: 26px;
    font-weight: bold;
    text-align: center;
    margin-bottom: 26px;
    outline: none;
  }

  .input-name:focus {
    border-color: #ffffff;
    box-shadow: 0 0 16px rgba(251, 191, 36, 0.8);
  }

  .btn-balatro {
    font-family: var(--font-arcade);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.5px;
    padding: 18px 36px;
    border-radius: 14px;
    border: 3px solid #ffffff;
    background: var(--balatro-orange);
    color: #ffffff;
    cursor: pointer;
    text-transform: uppercase;
    box-shadow: 0 6px 0 #8c4b00, 0 12px 18px rgba(0, 0, 0, 0.5);
    transition: all 0.1s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    outline: none;
  }

  .btn-balatro:hover {
    transform: translateY(-2px);
    box-shadow: 0 7px 0 #8c4b00, 0 12px 18px rgba(0, 0, 0, 0.5);
    filter: brightness(1.1);
  }

  .btn-balatro:active {
    transform: translateY(4px);
    box-shadow: 0 1px 0 #8c4b00, 0 3px 6px rgba(0, 0, 0, 0.5);
  }

  .btn-icon {
    width: 20px;
    height: 20px;
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .modal-box {
      padding: 24px 18px;
      border-radius: 18px;
      border-width: 3px;
      max-width: 92%;
    }

    .modal-svg-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 8px;
    }

    .modal-title {
      font-size: 22px;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }

    .modal-desc {
      font-size: 14px;
      margin-bottom: 18px;
    }

    .input-name {
      font-size: 20px;
      padding: 12px 16px;
      margin-bottom: 18px;
    }

    .btn-balatro {
      font-size: 15px;
      padding: 13px 18px;
      border-radius: 10px;
      letter-spacing: 0.3px;
      gap: 8px;
    }
  }
</style>
